{
  "name": "signal-lock-devvit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Signal Lock — Daily 5x5 Laser Mirror Puzzle built on Reddit Devvit Web (@devvit/web) for Reddit's Game of the Day Hackathon.",
  "scripts": {
    "dev:vite": "vite",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --outfile=dist/server/index.cjs",
    "build": "npm run build:client && npm run build:server",
    "test": "node --experimental-strip-types --test tests/puzzle.test.ts",
    "devvit:playtest": "devvit playtest"
  },
  "dependencies": {
    "@devvit/web": "0.15.4",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "devvit": "0.15.4",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
